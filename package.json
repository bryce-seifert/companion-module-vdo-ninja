{
	"name": "vdo-ninja",
	"version": "2.5.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"test:e2e:install": "playwright install chromium"
	},
	"license": "MIT",
	"dependencies": {
		"@companion-module/base": "~2.2.1",
		"ws": "^8.21.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-vdo-ninja.git"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26.6.5",
		"@types/ws": "^8.18.1",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
